{
  "name": "@local/thorn-github-kanban",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "dsh Web UI 插件:GitHub Projects(Projects v2)看板全局面板。同一个包同时提供宿主半边(数据服务)与浏览器半边(左栏 Global panels 入口 + 主区页面)",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  }
}
